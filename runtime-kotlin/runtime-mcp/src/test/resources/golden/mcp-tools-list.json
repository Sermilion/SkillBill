    {
      "name": "feature_task_phase_block",
      "description": "Durable-block a prose feature-task phase.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_id",
          "phase_id",
          "attempt",
          "reason"
        ],
        "properties": {
          "workflow_id": {
            "type": "string",
            "minLength": 1
          },
          "phase_id": {
            "type": "string",
            "enum": [
              "preplan",
              "plan",
              "implement",
              "simplify",
              "implement_fix",
              "review",
              "build",
              "verify_findings",
              "audit",
              "audit_plan_fix",
              "audit_implement_fix",
              "validate",
              "write_history",
              "pr"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "failure_disposition": {
            "type": "string",
            "enum": [
              "retryable",
              "non_retryable_policy_conflict",
              "needs_user_action",
              "process_failure",
              "invalid_output"
            ]
          },
          "verdict": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
