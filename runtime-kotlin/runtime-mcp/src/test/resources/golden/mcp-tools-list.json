              "skipped"
            ]
          },
          "completion_status": {
            "type": "string",
            "enum": [
              "completed",
              "abandoned_at_review",
              "abandoned_at_audit",
              "error"
            ]
          },
          "history_relevance": {
            "type": "string",
            "enum": [
              "none",
              "irrelevant",
              "low",
              "medium",
              "high"
            ]
          },
          "history_helpfulness": {
            "type": "string",
            "enum": [
              "none",
              "irrelevant",
              "low",
              "medium",
              "high"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "gaps_found": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "orchestrated": {
            "type": "boolean"
          },
          "acceptance_criteria_count": {
            "type": "integer"
          },
          "rollout_relevant": {
            "type": "boolean"
          },
          "spec_summary": {
            "type": "string"
          },
          "duration_seconds": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
