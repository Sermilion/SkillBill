    {
      "name": "feature_verify_workflow_update",
      "description": "Update durable bill-feature-verify workflow state and return a compact acknowledgement.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_id",
          "workflow_status",
          "current_step_id"
        ],
        "properties": {
          "workflow_id": {
            "type": "string"
          },
          "workflow_status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "abandoned"
            ]
          },
          "current_step_id": {
            "type": "string",
            "enum": [
              "collect_inputs",
              "extract_criteria",
              "gather_diff",
              "feature_flag_audit",
              "code_review",
              "unit_test_value_check",
              "completeness_audit",
              "verdict",
              "finish"
            ]
          },
          "step_updates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step_id",
                "status",
                "attempt_count"
              ],
              "properties": {
                "step_id": {
                  "type": "string",
                  "enum": [
                    "collect_inputs",
                    "extract_criteria",
                    "gather_diff",
                    "feature_flag_audit",
                    "code_review",
                    "unit_test_value_check",
                    "completeness_audit",
                    "verdict",
                    "finish"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "running",
                    "completed",
                    "failed",
                    "blocked",
                    "skipped",
                    "paused"
                  ]
                },
                "attempt_count": {
                  "type": "integer"
                }
              }
            }
          },
          "artifacts_patch": {
            "type": "object"
          },
          "session_id": {
            "type": "string"
          }
        }
      }
    },
